# Set the GotoSetpoint streamed in GOTO state. Accepted outside offboard; it is
# saved and published once offboard.
uint32 lease_id
float32[3] position # [m] NED local frame
float32 heading # [rad] from North; NaN to leave heading uncontrolled
float32 max_horizontal_speed # [m/s]; NaN for the PX4 default (MPC_XY_CRUISE)
---
bool success
string message
