#!/usr/bin/env bash
set -eo pipefail
source /opt/ros/jazzy/setup.bash
source "$HOME/.local/share/no-crash/environment.sh"
export NO_CRASH_CHECK_MODE=${1:---build}
"$HOME/.venvs/vision/bin/python" - <<'PY'
import importlib.metadata
import os
import re
import cv2
import numpy as np
import torch
import torchvision
import ultralytics
from cv_bridge import CvBridge

assert cv2.__version__.startswith('4.14.'), cv2.__version__
assert re.search(r'GStreamer:\s+YES', cv2.getBuildInformation()), cv2.getBuildInformation()
capture = cv2.VideoCapture('videotestsrc num-buffers=1 ! videoconvert ! video/x-raw,format=BGR ! appsink', cv2.CAP_GSTREAMER)
ok, frame = capture.read()
capture.release()
assert ok and frame is not None, 'OpenCV GStreamer capture failed'
bridge = CvBridge()
image = np.zeros((4, 4, 3), dtype=np.uint8)
assert np.array_equal(bridge.imgmsg_to_cv2(bridge.cv2_to_imgmsg(image, encoding='bgr8')), image)
print('OpenCV:', cv2.__version__, 'NumPy:', np.__version__, 'PyTorch:', torch.__version__)
print('torchvision:', torchvision.__version__, 'Ultralytics:', ultralytics.__version__)
print('OpenCV wheel:', importlib.metadata.version('opencv-python'))
if os.environ['NO_CRASH_CHECK_MODE'] == '--gpu':
    assert torch.cuda.is_available(), 'Selected GPU backend is unavailable; check the host runtime and drivers'
    value = torch.ones(4, device='cuda').sum().item()
    assert value == 4
    print('GPU:', torch.cuda.get_device_name(0), 'HIP:', torch.version.hip, 'CUDA:', torch.version.cuda)
else:
    assert torch.ones(4).sum().item() == 4
PY
gst-inspect-1.0 webrtcsink >/dev/null
gst-inspect-1.0 webrtcbin >/dev/null
gst-webrtc-signalling-server --help >/dev/null
MicroXRCEAgent udp4 --help >/dev/null
node --version
bun --version
bunx --version
rustc --version
test -x "$HOME/.local/opt/qgc/AppRun"
test -x "$HOME/build/PX4-Autopilot/build/px4_sitl_default/bin/px4"
printf 'no_crash toolchain checks passed (%s).\n' "$NO_CRASH_CHECK_MODE"
